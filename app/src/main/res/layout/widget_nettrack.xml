<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:baselineAligned="false"
    android:padding="12dp">

    <!-- Left Side: Cellular with Dial Meter -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_cellular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="CELLULAR"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dial Meter (Generated Canvas Bitmap) -->
        <ImageView
            android:id="@+id/widget_cellular_gauge"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginTop="2dp"
            android:contentDescription="Cellular Usage Meter"
            android:scaleType="fitCenter" />

        <!-- Subtitle: Usage / Limit -->
        <TextView
            android:id="@+id/widget_cellular_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 B / 2.0 GB"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

    </LinearLayout>

    <!-- Subtle Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#334155" />

    <!-- Right Side: Wi-Fi with Prominent Number -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_wifi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="WI-FI"
                android:textColor="#818CF8"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Wi-Fi Big Number -->
        <TextView
            android:id="@+id/widget_wifi_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 B"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/widget_wifi_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Today's Wi-Fi"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
